includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 6

    ignoreErrors:
        - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Model::#'
